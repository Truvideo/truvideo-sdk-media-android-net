<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>2.0.2</Version>
        <TargetFramework>net10.0-android</TargetFramework>
        <MauiVersion>10.0.10</MauiVersion>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsBindingProject>true</IsBindingProject>
        <RepositoryUrl>https://github.com/Truvideo/truvideo-sdk-media-android-net</RepositoryUrl>
        <!-- Suppress package downgrade warning -->
    </PropertyGroup>

    <!-- Native Gradle module reference -->
    <ItemGroup>
        <NLIGradleProjectReference Include="../TruVideoMediaAndroid">
            <ModuleName>TruvideoMedia</ModuleName>
        </NLIGradleProjectReference>
    </ItemGroup>

    <!-- Optional MAUI packages (only if testing in a MAUI app project) -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <!-- Room / SQLite -->
        <PackageReference Include="Xamarin.AndroidX.Room.Runtime" Version="2.8.3"/>
        <PackageReference Include="Xamarin.AndroidX.Sqlite" Version="2.6.1"/>
        <PackageReference Include="Xamarin.AndroidX.Sqlite.Framework" Version="2.6.1"/>
    </ItemGroup>

    <!-- Android AAR/JAR references -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
        <!-- TruVideo Media SDK AAR -->
        <AndroidLibrary Include="..\TruVideoMediaAndroid\TruvideoMedia\libs\sdk-media-1.0.5.aar" Bind="false" Visible="false" /> 
      
    </ItemGroup>

    <!-- Required for NativeLibraryInterop build -->
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui.NativeLibraryInterop.BuildTasks" Version="0.0.1-pre1" />
    </ItemGroup>
</Project>