<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>1.0.0</Version>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsBindingProject>true</IsBindingProject>
        <RepositoryUrl>https://github.com/Truvideo/truvideo-sdk-media-android-net</RepositoryUrl>
        <!-- Suppress package downgrade warning -->
    </PropertyGroup>

    <!-- Native Gradle module reference -->
    <ItemGroup>
        <NLIGradleProjectReference Include="../TruVideoMediaAndroid">
            <ModuleName>TruvideoMedia</ModuleName>
        </NLIGradleProjectReference>
    </ItemGroup>

    <!-- Optional MAUI packages (only if testing in a MAUI app project) -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0"/>
    </ItemGroup>

    <!-- Android AAR/JAR references -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
        <!-- TruVideo Media SDK AAR -->
        <AndroidLibrary Include="..\TruVideoMediaAndroid\TruvideoMedia\libs\truvideo-sdk-android-media-78.1.9.aar" Bind="false" Visible="false" />
        <!-- Android Room persistence library -->
        <AndroidLibrary Include="..\TruVideoMediaAndroid\TruvideoMedia\libs\room-common-2.6.1.jar" Bind="false" Visible="false" />
        <AndroidLibrary Include="..\TruVideoMediaAndroid\TruvideoMedia\libs\room-ktx-2.6.1.aar" Bind="false" Visible="false" />
        <AndroidLibrary Include="..\TruVideoMediaAndroid\TruvideoMedia\libs\room-runtime-2.6.1.aar" Bind="false" Visible="false" />
        <!-- Android SQLite library -->
        <AndroidLibrary Include="..\TruVideoMediaAndroid\TruvideoMedia\libs\sqlite-framework-2.4.0.aar" Bind="false" Visible="false" />
        <AndroidLibrary Include="..\TruVideoMediaAndroid\TruvideoMedia\libs\sqlite-2.4.0.aar" Bind="false" Visible="false" />
    </ItemGroup>

    <!-- Required for NativeLibraryInterop build -->
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui.NativeLibraryInterop.BuildTasks" Version="0.0.1-pre1" />
    </ItemGroup>
</Project>